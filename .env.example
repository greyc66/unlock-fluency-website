# Settings used by the Cloudflare Pages Functions in functions/api/.
# Set real values in Cloudflare Pages (Settings, Environment variables) and,
# for local testing, in .dev.vars (never commit real values).

# Resend (sends all emails): https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key
# Resend audience that newsletter subscribers are added to
RESEND_AUDIENCE_ID=your_resend_audience_id

# Where contact form, retreat registration, and newsletter notifications are sent
CONTACT_EMAIL=contact@unlockfluency.co.uk

# Signs newsletter unsubscribe links (any long random string)
UNSUBSCRIBE_SECRET=a_long_random_string

# Stripe webhook for paid handouts
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Cloudflare R2 storage that holds the paid handout PDFs
R2_ENDPOINT=your_r2_endpoint
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
